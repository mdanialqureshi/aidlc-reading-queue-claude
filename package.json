{
  "name": "reading-queue",
  "version": "1.0.0",
  "description": "A local, dependency-light CLI for managing a personal reading backlog stored in a human-readable JSON file.",
  "type": "module",
  "bin": {
    "reading-queue": "dist/bin/reading-queue.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,js,ts}\" README.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,js,ts}\" README.md"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.0"
  }
}
